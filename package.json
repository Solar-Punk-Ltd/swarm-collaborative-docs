{
  "name": "@solarpunkltd/swarm-collaborative-docs",
  "version": "0.0.1",
  "description": "",
  "author": "solarpunkltd",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Solar-Punk-Ltd/swarm-collaborative-docs"
  },
  "main": "dist/SwarmCollaborativeDocs.cjs.js",
  "browser": "dist/SwarmCollaborativeDocs.js",
  "types": "dist/SwarmCollaborativeDocs.d.ts",
  "exports": {
    ".": {
      "types": "./dist/SwarmCollaborativeDocs.d.ts",
      "require": "./dist/SwarmCollaborativeDocs.cjs.js",
      "import": "./dist/SwarmCollaborativeDocs.js",
      "default": "./dist/SwarmCollaborativeDocs.cjs.js"
    },
    "./style.css": "./dist/SwarmCollaborativeDocs.css"
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "start": "vite",
    "build": "pnpm build:lib",
    "build:lib": "rimraf ./dist && BUILD_MODE=lib vite build",
    "build:app": "rimraf ./dist && vite build",
    "lint": "eslint . --report-unused-disable-directives --no-cache --max-warnings=5",
    "lint:fix": "pnpm run lint --fix",
    "check:types": "tsc -p tsconfig.lib.json --noEmit",
    "depcheck": "depcheck .",
    "init:husky": "pnpm husky install"
  },
  "dependencies": {
    "@ethersphere/bee-js": "github:Apiary-Suite/bee-js",
    "@solarpunkltd/comment-system": "^1.9.5",
    "@waku/sdk": "^0.0.36",
    "lucide-react": "^1.8.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "y-monaco": "^0.1.6",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.30"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "8.58.0",
    "@typescript-eslint/parser": "8.58.0",
    "@vitejs/plugin-react": "^6.0.1",
    "depcheck": "^1.4.7",
    "eslint": "9.39.4",
    "eslint-config-prettier": "9.1.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "husky": "^9.1.7",
    "prettier": "3.8.1",
    "rimraf": "^6.1.3",
    "sass": "^1.99.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.6",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-node-polyfills": "^0.26.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  }
}
